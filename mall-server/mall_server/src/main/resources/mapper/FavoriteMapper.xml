<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ngsz.mall_server.mapper.FavoriteMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorite (user_id, product_id) VALUES (#{userId}, #{productId})
    </insert>

    <delete id="deleteByUserAndProduct">
        DELETE FROM favorite WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>

    <select id="findByUserId" resultType="com.ngsz.mall_server.pojo.Favorite">
        SELECT * FROM favorite WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="findByUserAndProduct" resultType="com.ngsz.mall_server.pojo.Favorite">
        SELECT * FROM favorite WHERE user_id = #{userId} AND product_id = #{productId}
    </select>
</mapper>
